# LEGACY REFERENCE ONLY. Tidak dibaca oleh entry point yang sekarang.
# Format konfigurasi baru akan ditetapkan saat implementasi Ansible.
# Jangan source config yang belum dipercaya: shell config adalah kode executable.
# Jangan simpan password admin atau auth key Tailscale dalam file ini.

HOSTNAME=vpslab              # (vpslab)   nama host + nama Tailscale
ADMIN_USER=vpsadmin          # (vpsadmin) user admin non-root
TIMEZONE=Asia/Jakarta        # (Asia/Jakarta)
SWAP_SIZE=4G                 # (4G)
DEFAULT_PORT=8080            # (8080)     port default tiap lab
DEFAULT_IMAGE=nginx:alpine   # (nginx:alpine)  image default templat
INSTALL_TOOLS=true           # (true)
