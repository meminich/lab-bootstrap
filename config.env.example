# Salin jadi config.env kalau mau ubah nilai default.
# Kosongkan / hapus baris = pakai default (dalam kurung).
# JANGAN commit config.env (berisi rahasia).

HOSTNAME=vpslab              # (vpslab)   nama host + nama Tailscale
ADMIN_USER=vpsadmin          # (vpsadmin) user admin non-root
# ADMIN_PASSWORD=            # (kosong)   kosong = ditanya saat setup
TIMEZONE=Asia/Jakarta        # (Asia/Jakarta)
SWAP_SIZE=4G                 # (4G)
DEFAULT_PORT=8080            # (8080)     port default tiap lab
DEFAULT_IMAGE=nginx:alpine   # (nginx:alpine)  image default templat
# TAILSCALE_AUTHKEY=         # (kosong)   kosong = login pakai link
INSTALL_TOOLS=true           # (true)
